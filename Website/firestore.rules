rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each player can read and write ONLY their own subtree.
    // The game client writes with the player's own auth token, so this is enough.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
